# Email Service Credentials for Vercel Serverless Function (/api/send-email)
# If using Gmail, generate an App Password at: https://myaccount.google.com/apppasswords

# The email address used to send the notification
EMAIL_USER=your_email@gmail.com

# 16-character Google App Password (not your normal Gmail login password)
EMAIL_PASS=your_app_password_here

# (Optional) Destination inbox where project dossiers should arrive (defaults to EMAIL_USER if not set)
EMAIL_TO=your_email@gmail.com

# (Optional) Email service provider (defaults to gmail)
EMAIL_SERVICE=gmail
